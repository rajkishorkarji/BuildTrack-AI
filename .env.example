# Application URL (for production / Oracle Cloud set to http://<YOUR_PUBLIC_IP> or https://<YOUR_DOMAIN>)
FRONTEND_URL=http://localhost

# Security Secrets
JWT_SECRET=replace-with-a-strong-base64-secret
SUPER_ADMIN_EMAIL=admin@buildtrack.ai
SUPER_ADMIN_PASSWORD=ChangeMeNow!123

# Razorpay Integration (Leave blank to use built-in sandbox mock)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth2 Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Email Configuration (Optional)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
